{
  "assembly": "solidworks/MM-Minimal.SLDASM",
  "robot_name": "MM_Minimal",

  "sw2robot_dir": "sw2robot",
  "cad_dir": "solidworks",

  "editor_exe": "%LOCALAPPDATA%\\sw2robot\\bin\\sw2robot-web.exe",

  "merge_fixed": true,
  "combine_meshes": true,
  "dedupe_meshes": true,

  "build_args": ["--collision", "hull"],

  "collision_cylinders": {
    "Mecanum_Wheel_dia_100_right_7": 0.050,
    "Mecanum_Wheel_dia_100_left_5": 0.050,
    "Mecanum_Wheel_dia_100_left_6": 0.050,
    "Mecanum_Wheel_dia_100_right_10": 0.050
  },

  "required_frames": ["lidar_link", "rgbd_camera_link", "wrist_camera_link",
                      "left_sonar_link", "right_sonar_link", "imu_link"]
}
